# 복사해서 .env 로 쓴다. 실제 값은 커밋하지 않는다.
#
# DATABASE_URL — 애플리케이션 런타임용. Neon/Supabase 라면 pooler 엔드포인트.
# DIRECT_URL   — 마이그레이션용 직결 엔드포인트.
#                PgBouncer transaction 모드로는 Prisma Migrate 가 동작하지 않는다.
#                Neon 은 호스트에서 "-pooler" 를 뺀 것이 직결 주소다.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DBNAME?sslmode=require"
